[Unit]
Description=Daily state snapshot
Documentation=https://github.com/agb1986/torrent-agent

[Timer]
# Early, before the day's activity: a snapshot of last night's state is more
# useful than one taken halfway through whatever went wrong today.
OnCalendar=*-*-* 04:00:00
Persistent=true
AccuracySec=10m

[Install]
WantedBy=timers.target
