[Unit]
Description=Fetch new episodes of followed series as they air
Documentation=https://github.com/agb1986/torrent-agent
After=network-online.target docker.service
Wants=network-online.target
# A missing token makes it exit 1 every time; stop rather than loop forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__REPO__
# Shares the bot's file: same token, same allowlist, same daily budget. One
# ceiling on spend rather than two that can each be under their own limit.
EnvironmentFile=__REPO__/.env.bot
ExecStart=__REPO__/.venv/bin/python -u -m server.sub
# always, like the notifier: it should outlive TVmaze outages and Deluge
# restarts. A failed tick is logged and the next one reconciles anyway, since
# it asks what is missing rather than what is due.
Restart=always
RestartSec=60

[Install]
WantedBy=default.target
