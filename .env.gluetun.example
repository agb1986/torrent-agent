# Template for .env.gluetun — the VPN container's secrets.
#   cp .env.gluetun.example .env.gluetun && chmod 600 .env.gluetun
# The real file is gitignored; this template is tracked. No values here, ever.

# --- PIA account ---------------------------------------------------------
# Use the ordinary account credentials: p-number (p1234567, never an email
# address) + the password you use on privateinternetaccess.com. The p-number
# is in /opt/piavpn/etc/account.json (root-owned) as "username", or on the
# PIA Account page.
#
# Do NOT use the openvpnUsername/openvpnPassword hex strings from that same
# file, tempting as they look. Those are derived from the client's auth token
# and rotate when it refreshes — gluetun would authenticate today and start
# failing silently later. The account password does not rotate.
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- gluetun control server ----------------------------------------------
# Generate your own, per machine — the laptop and casaos get different keys:
#   docker run --rm qmcgaw/gluetun genkey
# torrent_agent/vpn.py sends this as the control-server API key.
GLUETUN_API_KEY=
